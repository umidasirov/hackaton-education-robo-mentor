/* ── Bo‘lim mazmuni ───────────────────────────────────── */
const IntroSection: React.FC = () => (
  <div className="docs-section">
    <span className="docs-label">// umumiy maʼlumot</span>
    <h1>Kirish</h1>
    <p>
      <strong>Robo Mentor</strong> — bu brauzeringizda toʻliq ishlaydigan, ochiq manbali Arduino emulatori.
      Arduino C++ kodini yozing, uni <code>arduino-cli</code> orqali kompilyatsiya qiling va
      AVR8 / RP2040 protsessorlarining aniq emulyatsiyasi bilan simulyatsiya qiling.
    </p>

    <h2>Nima uchun Robo Mentor?</h2>
    <ul>
      <li><strong>O‘rnatish shart emas</strong>: hamma narsa brauzerda ishlaydi.</li>
      <li><strong>Haqiqiy emulyatsiya</strong>: aniq AVR8 / RP2040 protsessor emulyatsiyasi.</li>
      <li><strong>Interaktiv komponentlar</strong>: LEDlar, tugmalar, potensiometrlar, displeylar, datchiklar.</li>
      <li><strong>Ochiq manba</strong>: kodni ko‘ring, o‘zgartiring va o‘z serveringizda ishlating.</li>
    </ul>

    <h2>Qo‘llab-quvvatlanadigan platlar</h2>
    <table>
      <thead>
        <tr><th>Plata</th><th>Protsessor</th><th>Emulyator</th></tr>
      </thead>
      <tbody>
        <tr><td>Arduino Uno</td><td>ATmega328p @ 16 MHz</td><td>avr8js</td></tr>
        <tr><td>Arduino Nano</td><td>ATmega328p @ 16 MHz</td><td>avr8js</td></tr>
        <tr><td>Arduino Mega</td><td>ATmega2560 @ 16 MHz</td><td>avr8js</td></tr>
        <tr><td>Raspberry Pi Pico</td><td>RP2040 @ 133 MHz</td><td>rp2040js</td></tr>
        <tr><td>ESP32-C3 / XIAO C3</td><td>RV32IMC @ 160 MHz</td><td>Esp32C3Simulator</td></tr>
        <tr><td>ESP32 / ESP32-S3</td><td>Xtensa LX6/LX7 @ 240 MHz</td><td>QEMU</td></tr>
      </tbody>
    </table>

    <div className="docs-callout">
      <strong>Jonli namoyish:</strong>{' '}
      <a href="https://robomentor.uz" target="_blank" rel="noopener noreferrer">robomentor.uz</a>
    </div>
  </div>
);

const GettingStartedSection: React.FC = () => (
  <div className="docs-section">
    <span className="docs-label">// sozlash</span>
    <h1>Boshlash</h1>
    <p>Birinchi Arduino sketchni simulyatsiya qilish uchun quyidagi qadamlarni bajaring.</p>

    <h2>1-usul: Veb-versiyadan foydalanish</h2>
    <p>
      <a href="https://robomentor.uz" target="_blank" rel="noopener noreferrer">https://robomentor.uz</a>{' '}
      manziliga o‘ting va darhol kod yozishni boshlang.
    </p>

    <h2>2-usul: Docker bilan o‘z serveringizda ishga tushirish</h2>
    <CodeBlock language="bash">{`docker run -d \\
  --name robomentor \\
  -p 3080:80 \\
  -v $(pwd)/data:/app/data \\
  ghcr.io/davidmonterocrespo24/robomentor:master`}</CodeBlock>
    <p>Keyin brauzeringizda <strong>http://localhost:3080</strong> ni oching.</p>

    <h2>3-usul: Qo‘lda sozlash</h2>
    <p><strong>Talablar:</strong> Node.js 18+, Python 3.12+, <code>arduino-cli</code></p>

    <h3>1. Repositoryni klonlash</h3>
    <CodeBlock language="bash">{`git clone https://github.com/davidmonterocrespo24/robomentor.git
cd robomentor`}</CodeBlock>

    <h3>2. Backendni ishga tushirish</h3>
    <CodeBlock language="bash">{`cd backend
python -m venv venv && source venv/bin/activate
pip install -r requirements.txt
uvicorn app.main:app --reload --port 8001`}</CodeBlock>

    <h3>3. Frontendni ishga tushirish</h3>
    <CodeBlock language="bash">{`cd frontend
npm install
npm run dev`}</CodeBlock>

    <h2>Birinchi simulyatsiyangiz</h2>
    <ol>
      <li><strong>Muharrirni oching</strong> — <a href="https://robomentor.uz/editor" target="_blank">robomentor.uz/editor</a></li>
      <li><strong>Platani tanlang</strong> (masalan, <em>Arduino Uno</em>)</li>
      <li><strong>Arduino kodini yozing</strong></li>
    </ol>
    <CodeBlock language="cpp">{`void setup() {
  pinMode(13, OUTPUT);
}

void loop() {
  digitalWrite(13, HIGH);
  delay(500);
  digitalWrite(13, LOW);
  delay(500);
}`}</CodeBlock>
    <ol start={4}>
      <li><strong>"Kompilyatsiya" tugmasini bosing</strong></li>
      <li><strong>"Ishga tushir" tugmasini bosing</strong></li>
      <li><strong>Komponentlar qo‘shing</strong> — <strong>+</strong> tugmasi orqali</li>
      <li><strong>Simlarni ulang</strong></li>
    </ol>
  </div>
);

const EmulatorSection: React.FC = () => (
  <div className="docs-section">
    <span className="docs-label">// ichki tuzilish</span>
    <h1>Emulator Arxitekturasi</h1>
    <p>Robo Mentor <strong>haqiqiy protsessor emulyatsiyasi</strong> dan foydalanadi.</p>

    <h2>Yuqori darajadagi maʼlumotlar oqimi</h2>
    <CodeBlock language="text">{`Foydalanuvchi kodi (Monaco muharriri)
        │
        ▼
   Zustand Do‘koni (useEditorStore)
        │
        ▼
  FastAPI Backend ──► arduino-cli ──► .hex / .uf2 fayl
        │
        ▼
  AVRSimulator / RP2040Simulator
        │
        ▼
  Protsessor bajarilish sikli (~60 FPS)
        │
        ▼
  Port kuzatuvchilari (PORTB / PORTC / PORTD)
        │
        ▼
  PinManager ──► Komponent holati ──► React qayta chizish`}</CodeBlock>

    <h2>AVR8 Emulyatsiyasi (Arduino Uno / Nano / Mega)</h2>
    <p>AAR backend <a href="https://github.com/wokwi/avr8js" target="_blank">avr8js</a> dan foydalanadi.</p>

    <h3>Bajarilish sikli</h3>
    <p>Har bir kadr taxminan 267 000 protsessor sikli bajaradi:</p>
    <CodeBlock language="typescript">{`avrInstruction(cpu);
cpu.tick();`}</CodeBlock>

    <h3>Qo‘llab-quvvatlanadigan periferiyalar</h3>
    <table>
      <thead><tr><th>Periferiya</th><th>Tafsilotlar</th></tr></thead>
      <tbody>
        <tr><td>GPIO</td><td>PORTB (8–13), PORTC (A0–A5), PORTD (0–7)</td></tr>
        <tr><td>Timer0/1/2</td><td><code>millis()</code>, <code>delay()</code>, PWM</td></tr>
        <tr><td>USART</td><td>Serial Monitor</td></tr>
        <tr><td>ADC</td><td>10-bit, A0–A5</td></tr>
        <tr><td>SPI / I2C</td><td>To‘liq qo‘llab-quvvatlash</td></tr>
      </tbody>
    </table>

    <h2>RP2040 Emulyatsiyasi (Raspberry Pi Pico)</h2>
    <p>RP2040 backend <a href="https://github.com/wokwi/rp2040js" target="_blank">rp2040js</a> dan foydalanadi.</p>
    <ul>
      <li>133 MHz da haqiqiy RP2040 emulyatsiyasi</li>
      <li>UART0 serial chiqishi</li>
      <li>12-bit ADC (GPIO 26–29)</li>
    </ul>
  </div>
);

const ComponentsSection: React.FC = () => (
  <div className="docs-section">
    <span className="docs-label">// maʼlumotnoma</span>
    <h1>Komponentlar Maʼlumotnomasi</h1>
    <p>
      Robo Mentor <strong>48+ interaktiv elektron komponenti</strong> bilan ishlaydi.
      Barcha komponentlarni simulyatsiya maydoniga joylashtirish, simlar bilan ulash va Arduino kodi bilan boshqarish mumkin.
    </p>

    <h2>Komponent qo‘shish</h2>
    <ol>
      <li>Simulyatsiya maydonidagi <strong>+</strong> tugmasini bosing</li>
      <li><strong>Qidiruv</strong> yoki <strong>kategoriya</strong> bo‘yicha komponentni toping</li>
      <li>Komponentni maydonga joylashtirish uchun bosing</li>
      <li><strong>Sudrab</strong> olib borib joylashtiring</li>
    </ol>

    <h2>Komponentlarni ulash</h2>
    <ol>
      <li>Komponentdagi <strong>pinni</strong> bosing</li>
      <li><strong>Maqsad pinini</strong> bosing</li>
      <li>Simlar <strong>rang-kodlangan</strong> holda chiziladi</li>
    </ol>

    <h3>Komponent kategoriyalari</h3>

    <h4>Chiqish</h4>
    <table><thead><tr><th>Komponent</th><th>Tavsif</th></tr></thead>
    <tbody>
      <tr><td>LED</td><td>Konfiguratsiya qilinadigan rangli LED</td></tr>
      <tr><td>RGB LED</td><td>Uch rangli LED</td></tr>
      <tr><td>7-Segment Displey</td><td>Bir xonali raqamli displey</td></tr>
      <tr><td>LCD 16×2</td><td>2 qatorli matnli displey</td></tr>
      <tr><td>Buzzer</td><td>Passiv piezo buzzer</td></tr>
    </tbody></table>

    <h4>Kirish</h4>
    <table><thead><tr><th>Komponent</th><th>Tavsif</th></tr></thead>
    <tbody>
      <tr><td>Tugma</td><td>Momentli tugma</td></tr>
      <tr><td>Potensiometr</td><td>Analog kuchlanish bo‘luvchi</td></tr>
      <tr><td>Joystick</td><td>Ikki o‘qli analog joystick</td></tr>
    </tbody></table>

    <h4>Datchiklar</h4>
    <table><thead><tr><th>Komponent</th><th>Tavsif</th></tr></thead>
    <tbody>
      <tr><td>HC-SR04</td><td>Ultrasonik masofa sensori</td></tr>
      <tr><td>DHT22</td><td>Harorat va namlik sensori</td></tr>
      <tr><td>PIR</td><td>Harakat sensori</td></tr>
    </tbody></table>
  </div>
);

const RoadmapSection: React.FC = () => (
  <div className="docs-section">
    <span className="docs-label">// kelajak</span>
    <h1>Reja</h1>

    <h2>✅ Amalga oshirilgan</h2>
    <ul>
      <li>Monaco muharriri</li>
      <li>Ko‘p faylli ish maydoni</li>
      <li>Arduino kompilyatsiyasi (<code>arduino-cli</code>)</li>
      <li>ATmega328p / ATmega2560 emulyatsiyasi (avr8js)</li>
      <li>To‘liq GPIO, Taymerlar, USART, ADC, SPI, I2C</li>
      <li>RP2040 emulyatsiyasi (rp2040js)</li>
      <li>48+ komponent</li>
      <li>Sim yaratish va tahrirlash</li>
      <li>Serial Monitor</li>
      <li>Kutubxonalar menejeri</li>
      <li>Loyihalarni saqlash</li>
      <li>8 ta misol loyiha</li>
    </ul>

    <h2>🔄 Bajarilmoqda</h2>
    <ul>
      <li>Funksional sim ulanishlari</li>
      <li>Xatoliklarni qayta ishlash</li>
    </ul>

    <h2>🗓 Rejalashtirilgan</h2>
    <ul>
      <li>Bekor qilish / qaytarish</li>
      <li>Loyihalarni <code>.zip</code> sifatida eksport/import</li>
      <li>Qo‘shimcha platlar (ESP32, Arduino Leonardo)</li>
      <li>Breadboard qo‘llab-quvvatlash</li>
      <li>Ko‘proq datchik simulyatsiyalari</li>
      <li>Multiplayer rejimi</li>
    </ul>

    <div className="docs-callout">
      <strong>Hissa qo‘shmoqchimisiz?</strong>{' '}
      <a href={GITHUB_URL} target="_blank">github.com/davidmonterocrespo24/robomentor</a>
    </div>
  </div>
);

const ArchitectureSection: React.FC = () => (
  <div className="docs-section">
    <span className="docs-label">// tizim dizayni</span>
    <h1>Loyiha Arxitekturasi</h1>

    <h2>Yuqori darajadagi ko‘rinish</h2>
    <CodeBlock language="text">{`Brauzer (React + Vite)
  ├── Monaco muharriri ──► useEditorStore (Zustand)
  ├── SimulatorCanvas ──► useSimulatorStore (Zustand)
  │     ├── AVRSimulator (avr8js)
  │     ├── RP2040Simulator (rp2040js)
  │     ├── PinManager
  │     └── 48+ wokwi-elements
  └── HTTP (Axios) ──► FastAPI Backend (port 8001)
        └── ArduinoCLIService ──► arduino-cli`}</CodeBlock>

    <h2>Asosiy frontend do‘konlari</h2>
    <table>
      <thead><tr><th>Do‘kon</th><th>Maqsad</th></tr></thead>
      <tbody>
        <tr><td><code>useEditorStore</code></td><td>Ko‘p faylli ish maydoni</td></tr>
        <tr><td><code>useSimulatorStore</code></td><td>Simulyatsiya + maydon holati</td></tr>
        <tr><td><code>useAuthStore</code></td><td>Autentifikatsiya</td></tr>
        <tr><td><code>useProjectStore</code></td><td>Ochiq loyiha</td></tr>
      </tbody>
    </table>

    <h2>Backend marshrutlari</h2>
    <table>
      <thead><tr><th>Marshrut</th><th>Tavsif</th></tr></thead>
      <tbody>
        <tr><td><code>POST /api/compile/</code></td><td>Sketchni kompilyatsiya qilish</td></tr>
        <tr><td><code>GET /api/compile/boards</code></td><td>Platlar ro‘yxati</td></tr>
        <tr><td><code>GET/POST /api/auth/*</code></td><td>Autentifikatsiya</td></tr>
        <tr><td><code>GET/POST /api/projects/*</code></td><td>Loyiha saqlash</td></tr>
      </tbody>
    </table>
  </div>
);

const WokwiLibsSection: React.FC = () => (
  <div className="docs-section">
    <span className="docs-label">// ochiq manba kutubxonalar</span>
    <h1>Wokwi Kutubxonalari</h1>
    <p>Robo Mentor <code>wokwi-libs/</code> papkasida mahalliy klonlangan rasmiy Wokwi kutubxonalaridan foydalanadi.</p>

    <h2>Klonlangan repositorylar</h2>
    <table>
      <thead><tr><th>Kutubxona</th><th>Maqsad</th></tr></thead>
      <tbody>
        <tr><td>wokwi-elements</td><td>48+ Lit Web komponentlari</td></tr>
        <tr><td>avr8js</td><td>ATmega328p / ATmega2560 emulyatori</td></tr>
        <tr><td>rp2040js</td><td>Raspberry Pi Pico emulyatori</td></tr>
      </tbody>
    </table>

    <h2>Kutubxonalarni yangilash</h2>
    <CodeBlock language="bash">{`cd wokwi-libs/wokwi-elements
git pull origin main
npm install && npm run build`}</CodeBlock>
  </div>
);

const McpSection: React.FC = () => (
  <div className="docs-section">
    <span className="docs-label">// AI integratsiyasi</span>
    <h1>MCP Server</h1>
    <p>
      Robo Mentor{' '}
      <a href="https://modelcontextprotocol.io/" target="_blank">Model Context Protocol</a>{' '}
      (MCP) serverini qo‘llab-quvvatlaydi.
    </p>

    <h2>Mavjud asboblar</h2>
    <table>
      <thead><tr><th>Asbob</th><th>Tavsif</th></tr></thead>
      <tbody>
        <tr><td><code>compile_project</code></td><td>Arduino fayllarini kompilyatsiya qilish</td></tr>
        <tr><td><code>import_wokwi_json</code></td><td>Wokwi diagrammasini o‘qish</td></tr>
        <tr><td><code>export_wokwi_json</code></td><td>Sxemani Wokwi formatiga chiqarish</td></tr>
        <tr><td><code>create_circuit</code></td><td>Yangi sxema yaratish</td></tr>
        <tr><td><code>generate_code_files</code></td><td>Boshlang‘ich kod yaratish</td></tr>
      </tbody>
    </table>
  </div>
);

