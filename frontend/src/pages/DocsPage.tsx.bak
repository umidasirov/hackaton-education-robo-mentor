const RiscVEmulationSection: React.FC = () => (
  <div className="docs-section">
    <span className="docs-label">// risc-v</span>
    <h1>RISC-V Emulyatsiyasi (ESP32-C3)</h1>
    <p>
      ESP32-C3, XIAO ESP32-C3 va C3 SuperMini platlari <strong>RISC-V RV32IMC</strong> yadrosida ishlaydi.
      Robo Mentor ularni to‘liq brauzerda emulyatsiya qiladi.
    </p>

    <h2>Qo‘llab-quvvatlanadigan platlar</h2>
    <table>
      <thead><tr><th>Plata</th><th>CPU</th><th>Flash</th><th>RAM</th></tr></thead>
      <tbody>
        <tr><td>ESP32-C3</td><td>RV32IMC @ 160 MHz</td><td>4 MB</td><td>384 KB</td></tr>
        <tr><td>XIAO ESP32-C3</td><td>RV32IMC @ 160 MHz</td><td>4 MB</td><td>384 KB</td></tr>
        <tr><td>C3 SuperMini</td><td>RV32IMC @ 160 MHz</td><td>4 MB</td><td>384 KB</td></tr>
      </tbody>
    </table>

    <h2>Xotira xaritasi</h2>
    <table>
      <thead><tr><th>Hudud</th><th>Manzil</th><th>Hajmi</th></tr></thead>
      <tbody>
        <tr><td>IROM (Flash)</td><td><code>0x42000000</code></td><td>4 MB</td></tr>
        <tr><td>DRAM</td><td><code>0x3FC80000</code></td><td>384 KB</td></tr>
        <tr><td>UART0</td><td><code>0x60000000</code></td><td>1 KB</td></tr>
        <tr><td>GPIO</td><td><code>0x60004000</code></td><td>512 B</td></tr>
      </tbody>
    </table>
  </div>
);

const Esp32EmulationSection: React.FC = () => (
  <div className="docs-section">
    <span className="docs-label">// xtensa</span>
