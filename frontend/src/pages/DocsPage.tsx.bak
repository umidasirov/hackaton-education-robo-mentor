        <tr><td>ESP32-S3</td><td>Xtensa LX7 @ 240 MHz</td>
        <tr><td>ESP32-CAM</td><td>Xtensa LX6 @ 240 MHz</td>
        <tr><td>XIAO ESP32-S3</td><td>Xtensa LX7 @ 240 MHz</td>
      </tbody>
    </table>
  </div>
);

